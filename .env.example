# 로컬 실습 설정입니다. 앱은 .env를 자동으로 읽지 않습니다.
LIBRARY_DATABASE_URL=sqlite:///./library.db
# development에서는 개발용 디버그 버튼을 활성화합니다.
LIBRARY_ENV=development
SESSION_SECRET_KEY=replace-with-your-own-random-secret

# production에서는 32자 이상의 무작위 세션 키와 HTTPS가 필요합니다.
# 로컬 HTTP 실습 시 LIBRARY_ENV=development로 설정하세요.
# GitHub OAuth App의 callback과 정확히 일치시킵니다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback
